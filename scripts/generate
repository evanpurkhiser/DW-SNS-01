#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
silabs_home=${SILABS_HOME:-"$root/.silabs-home"}
cd "$root"

package_path() {
	HOME="$silabs_home" slt where "$1" --ignore-slconf --non-interactive
}

slc_dir=$(package_path slc-cli/6.0.23)
java_dir=$(package_path java21/21.0.6)
python_dir=$(package_path python/3.10.3)
zap_dir=$(package_path zap/2026.06.17)
sdk_dir=$(package_path simplicity-sdk/2025.6.2)
gcc_dir=$(package_path gcc-arm-none-eabi/12.2.rel1)

if [[ -z "$slc_dir" || -z "$java_dir" || -z "$python_dir" || -z "$zap_dir" || -z "$sdk_dir" || -z "$gcc_dir" ]]; then
	echo "Silicon Labs packages are missing; run 'mise run setup' first" >&2
	exit 1
fi

java_home="$java_dir"
if [[ -d "$java_dir/jre" ]]; then
	java_home="$java_dir/jre"
fi

HOME="$silabs_home" JAVA_HOME="$java_home" JAVA_TOOL_OPTIONS="-Duser.home=$silabs_home" \
	PATH="$java_home/bin:$PATH" "$slc_dir/slc" generate \
	firmware/dishwasher_sensor.slcp \
	--ignore-slt \
	--sdk-package-path "$sdk_dir" \
	--toolchain-locations "gcc:$gcc_dir" \
	--tool-path "$java_dir" \
	--tool-path "$python_dir" \
	--tool-path "$slc_dir" \
	--tool-path "$zap_dir" \
	--with brd4187c \
	--export-destination firmware \
	--force

git apply --whitespace=nowarn scripts/xiao-generated-overrides.patch
